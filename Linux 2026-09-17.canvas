		},
		{
			"id":"34656c211bf2ab55",
			"type":"text",
			"text":"建立一個管理者帳號，設定密碼（1111）",
			"styleAttributes":{},
			"x":-220,
			"y":440,
			"width":260,
			"height":60
		},
		{
			"id":"f4f7f43d7b9ec603",
			"type":"text",
			"text":"MYSQL:\nCREATE USER 'admin'@'%' IDENTIFIED BY '1234';",
			"styleAttributes":{},
			"x":-220,
			"y":560,
			"width":260,
			"height":80
		},
		{
			"id":"43350fe9ff799533",
			"type":"text",
			"text":"在終端機先建立帳號密碼，再去workbench按+去使用這個帳密新增一個連接",
			"styleAttributes":{},
			"x":120,
			"y":560,
