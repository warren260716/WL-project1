{
	"nodes":[
		{
			"id":"04a805855d6f42b3",
			"type":"text",
			"text":"Windows跟linux，選擇最適合專案需求的系統",
			"styleAttributes":{},
			"x":-120,
			"y":-320,
			"width":260,
			"height":60
		},
		{
			"id":"1d77684cc6cf6940",
			"type":"text",
			"text":"windows：黑箱，底層程式碼不開放",
			"styleAttributes":{},
			"x":-380,
			"y":-200,
			"width":260,
			"height":60
		},
		{
			"id":"cee13cb37aa7838e",
			"type":"text",
			"text":"linux：（ubuntu）主要使用程式碼操控",
			"styleAttributes":{},
			"x":140,
			"y":-200,
			"width":260,
			"height":60
		},
		{
			"id":"387ac9c912c75e6d",
			"type":"text",
			"text":"系統對硬體有極高的相容性",
			"styleAttributes":{},
			"x":-380,
			"y":-80,
			"width":260,
			"height":60
		},
		{
			"id":"a389a525a7280075",
			"type":"text",
			"text":"需手動精選相容硬體",
			"styleAttributes":{},
			"x":140,
			"y":-80,
			"width":260,
			"height":60
		},
		{
			"id":"14ea3526e77e2707",
			"type":"text",
			"text":"參考\"Linux-ubuntu24操作.docx\" 執行指令操作",
			"styleAttributes":{},
			"x":-220,
			"y":80,
			"width":260,
			"height":60
		},
		{
			"id":"919a46956bec9bcf",
			"type":"text",
			"text":"每次安裝軟體前執行\nsudo apt update",
			"styleAttributes":{},
			"x":-220,
			"y":200,
			"width":260,
			"height":60
		},
		{
			"id":"45239ab49c591c05",
			"type":"text",
			"text":"systemctl status xxxx\n看一下目前xxxx的執行狀態",
			"styleAttributes":{},
			"x":-220,
			"y":320,
			"width":260,
			"height":60
		},
		{
			"id":"c04f66003a29ab03",
			"type":"text",
			"text":"05_MySQL8.0資料庫安裝與設定v2.docx（資料庫安裝說明）",
			"styleAttributes":{},
