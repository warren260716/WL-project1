{
	"nodes":[
		{
			"id":"dabb493558cdae49",
			"type":"text",
			"text":"Linux → 原始的沒有版權問題，程式碼公開",
			"styleAttributes":{
				"shape":null
			},
			"x":-880,
			"y":-600,
			"width":350,
			"height":60
		},
		{
			"id":"877b93f16195c947",
			"type":"text",
			"text":"程式碼可掌控（後段所有執行都可以監控）",
			"styleAttributes":{},
			"x":-880,
			"y":-480,
			"width":350,
			"height":60
		},
		{
			"id":"4a3c661a51ec4731",
			"type":"text",
			"text":"便宜",
			"styleAttributes":{},
			"x":-460,
			"y":-480,
			"width":78,
			"height":60
		},
		{
			"id":"368f278113c3866a",
			"type":"text",
			"text":"檔案也有權限管理",
			"styleAttributes":{},
			"x":-880,
			"y":-360,
			"width":260,
			"height":60
		},
		{
			"id":"430e987b96fff90a",
			"type":"text",
			"text":"不支援特定功能，要自已做，要自已想辦法解決",
			"styleAttributes":{},
			"x":-880,
			"y":-240,
			"width":260,
			"height":60
		},
		{
			"id":"9ef52ebcee8e9965",
			"type":"text",
			"text":"Ubuntu是由社群共同開發，目前還是免費",
			"styleAttributes":{},
			"x":-880,
			"y":-120,
			"width":260,
			"height":60
		},
		{
			"id":"01e2d3dd8147f9a9",
			"type":"text",
			"text":"為什麽要用windows做遠端登入linux",
			"styleAttributes":{},
			"x":-880,
			"y":20,
			"width":260,
			"height":60
		},
		{
			"id":"c3e40dc87c3f1550",
			"type":"text",
			"text":"以後可能在雲端租用linux系統的硬碟，就需要從windows遠端登入連線",
			"styleAttributes":{},
			"x":-880,
			"y":140,
			"width":360,
			"height":60
		},
		{"id":"a899fcffc1acb243","type":"file","file":"Pasted image 20260910132105.png","x":-400,"y":100,"width":400,"height":142},
		{
			"id":"7b2a0775fb876c06",
			"type":"text",
			"text":"在linux系統key\nhostname -I\n→ 查詢虛擬機的IP",
			"styleAttributes":{},
			"x":-880,
			"y":-1040,
			"width":260,
			"height":100
		},
		{
			"id":"471a15ddb57fdc6f",
			"type":"text",
			"text":"在dos下面key\nssh 使用者名稱@虛擬機IP\n→ 進入linux操作",
			"styleAttributes":{},
			"x":-880,
			"y":-880,
			"width":260,
			"height":80
		},
		{
			"id":"4867fa8245781e9e",
			"type":"text",
			"text":"修改root密碼在終端機執行，不是在VMware執行，要先登入一般使用者",
			"styleAttributes":{},
			"x":-880,
			"y":340,
			"width":260,
			"height":100
		},
		{"id":"143050e3da884570","type":"file","file":"Pasted image 20260910152653.png","x":-500,"y":340,"width":400,"height":142},
